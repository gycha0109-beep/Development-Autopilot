{
  "manifest_version": 3,
  "name": "Development Autopilot — Existing Chat Sessions",
  "short_name": "Autopilot",
  "description": "선택한 기존 ChatGPT 개발 대화 탭에 승인된 후속 지시를 전달하고 로컬 CI 상태를 관리합니다.",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Development Autopilot",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*"
  ]
}
