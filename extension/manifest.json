{
  "manifest_version": 3,
  "name": "Development Autopilot — Session Manager",
  "short_name": "Autopilot",
  "description": "등록된 Chrome 탭 세션을 로컬 Autopilot에 안전하게 연결하는 읽기 전용 관리 확장.",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Development Autopilot",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "host_permissions": [
    "http://127.0.0.1:48173/*"
  ]
}
