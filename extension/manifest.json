{
  "manifest_version": 3,
  "name": "Development Autopilot — Existing Chat Sessions",
  "short_name": "Autopilot",
  "description": "등록된 ChatGPT 개발 대화의 이관 프롬프트 작성·복사·프로젝트 새 채팅 전송과 승인된 후속 작업을 관리합니다.",
  "version": "0.4.6",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Development Autopilot",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*"
  ]
}
