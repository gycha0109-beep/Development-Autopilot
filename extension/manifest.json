{
  "manifest_version": 3,
  "name": "Development Autopilot — Existing Chat Sessions",
  "short_name": "Autopilot",
  "description": "등록된 ChatGPT 개발 대화의 길이 제한을 감시하여 사용자 설정에 따라 로드맵 이관·새 프로젝트 채팅·제목 변경과 자동 후속 전송을 수행합니다.",
  "version": "0.4.48",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Development Autopilot",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*"
  ]
}
