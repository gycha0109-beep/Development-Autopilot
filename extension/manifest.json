{
  "manifest_version": 3,
  "name": "Development Autopilot — Existing Chat Sessions",
  "short_name": "Autopilot",
  "description": "사용자가 등록한 기존·새 ChatGPT 대화 및 프로젝트 새 채팅에 승인된 지시를 전달하고 로컬 CI 상태를 관리합니다.",
  "version": "0.4.5",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Development Autopilot",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*"
  ]
}
